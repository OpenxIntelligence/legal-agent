# Copy to .env. Never commit the populated file.
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1
MODEL_API_MODEL=muse-spark-1.3
SAM_MODEL=sam-3.1
# Free CourtListener token for caselaw lookups (all collections share
# one token). Get one at courtlistener.com; leave blank to keep the
# lookups unavailable. This file is bash-sourced: wrap values containing
# spaces or $ ! # & in single quotes.
COURTLISTENER_TOKEN=
# The case to work on: a folder with objective.md and documents/ (relative to this directory).
CASE_DIR=../examples/cases/northbridge-v-caldera
# Verification layer for new runs: the checks in verification/, escalation, attorney sign-off (off | on).
VERIFICATION=on
# Per-run token budget for new runs (agent turns + tool model calls); unset = unlimited.
#RUN_TOKEN_BUDGET=
# Max request context bytes before a run pauses instead of calling the model (default 1500000).
#MAX_CONTEXT_BYTES=
